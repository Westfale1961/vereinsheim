/* ========================================================== */
/* Ab hier ist die Technik – normalerweise nichts ändern.      */
/* ========================================================== */

(function(){
  var ICONS = {
    abteilungen: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
    aktuelles:   '<path d="M5 4h11a2 2 0 0 1 2 2v13a1 1 0 0 0 1 1H6a2 2 0 0 1-2-2V5a1 1 0 0 1 1-1z"/><path d="M18 8h2v11a1 1 0 0 1-1 1"/><path d="M8 8h6M8 12h6M8 16h4"/>',
    termine:     '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
    kontakt:     '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
    mitglied:    '<circle cx="9" cy="8" r="4"/><path d="M2 21c0-4 3-7 7-7s7 3 7 7"/><path d="M19 8v6M16 11h6"/>'
  };
  var TABS = [
    { id: "abteilungen", label: "Abteilungen" },
    { id: "aktuelles",   label: "Aktuelles" },
    { id: "termine",     label: "Termine" },
    { id: "kontakt",     label: "Kontakt" },
    { id: "mitglied",    label: "Mitglied werden" }
  ];

  var kacheln = document.getElementById("kacheln");
  var inhalt  = document.getElementById("inhalt");
  var fokusSetzen = false;   // Fokus nur nach Klicks verschieben, nicht beim ersten Laden

  /* ---------- Hilfsfunktionen ---------- */
  function h(tag, props, kids){
    var e = document.createElement(tag);
    for (var k in (props || {})){
      if (k === "class") e.className = props[k];
      else if (k === "text") e.textContent = props[k];
      else if (k.slice(0, 2) === "on") e.addEventListener(k.slice(2), props[k]);
      else e.setAttribute(k, props[k]);
    }
    (kids || []).forEach(function(c){
      if (c === null || c === undefined || c === false) return;
      e.appendChild(typeof c === "string" ? document.createTextNode(c) : c);
    });
    return e;
  }
  function svg(inner){
    var s = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    s.setAttribute("viewBox", "0 0 24 24");
    s.setAttribute("aria-hidden", "true");
    s.innerHTML = inner;
    return s;
  }
  function slug(t){
    return t.toLowerCase().replace(/ä/g,"ae").replace(/ö/g,"oe").replace(/ü/g,"ue").replace(/ß/g,"ss")
            .replace(/[^a-z0-9]+/g,"-").replace(/^-+|-+$/g,"");
  }
  function ext(text, pfad, cls){            // Link zur Homepage, öffnet im ganzen Fenster
    return h("a", { "class": cls || "btn", href: BASIS + pfad, target: "_top", rel: "noopener", text: text });
  }
  function go(teile){
    fokusSetzen = true;
    var neu = "#" + teile.map(encodeURIComponent).join("/");
    if (location.hash === neu) route(); else location.hash = neu;
  }
  function knopf(text, teile, cls){
    return h("button", { type: "button", "class": cls || "btn", text: text, onclick: function(){ go(teile); } });
  }
  function titel(text){ return h("h2", { text: text }); }

  function krumen(liste){                   // liste: [{text, teile}] – letztes Element = aktuelle Seite
    var n = h("nav", { "class": "krumen", "aria-label": "Pfad" });
    liste.forEach(function(k, i){
      if (i > 0) n.appendChild(h("span", { "class": "trenner", "aria-hidden": "true", text: "›" }));
      if (i === liste.length - 1) n.appendChild(h("span", { "aria-current": "page", text: k.text }));
      else n.appendChild(knopf(k.text, k.teile, ""));
    });
    return n;
  }
  function karte(name, sub, teile){
    return h("button", { type: "button", "class": "karte", onclick: function(){ go(teile); } }, [
      h("span", {}, [ h("strong", { text: name }), sub ? h("small", { text: sub }) : null ]),
      h("span", { "class": "pfeil", "aria-hidden": "true", text: "→" })
    ]);
  }

  /* ---------- Bereiche ---------- */
  function ansichtAbteilungen(p){
    var abt = null, grp = null, i, j;
    if (p[1]){
      for (i = 0; i < ABTEILUNGEN.length; i++) if (slug(ABTEILUNGEN[i].name) === p[1]) abt = ABTEILUNGEN[i];
    }
    if (abt && p[2]){
      abt.gruppen.forEach(function(k){ k.eintraege.forEach(function(e){ if (slug(e.name) === p[2]) grp = e; }); });
    }
    var wurzel = [{ text: "Abteilungen", teile: ["abteilungen"] }];

    // Ebene 1: Abteilungen
    if (!abt){
      var raster = h("div", { "class": "karten gross" });
      ABTEILUNGEN.forEach(function(a){ raster.appendChild(karte(a.name, a.kurz, ["abteilungen", slug(a.name)])); });
      return [ titel("Abteilungen"), h("p", { "class": "lead", text: "Wähle deinen Sport – dann siehst du die Gruppen mit allen Informationen." }), raster ];
    }

    // Ebene 3: Gruppe
    if (grp){
      var out = [
        krumen(wurzel.concat([{ text: abt.name, teile: ["abteilungen", slug(abt.name)] }, { text: grp.name }])),
        titel(grp.name)
      ];
      var inf = grp.info;
      if (inf){
        if (inf.text) out.push(h("p", { "class": "lead", text: inf.text }));
        var dl = h("dl", { "class": "info" });
        function zeile(bez, inhalt){ dl.appendChild(h("div", {}, [ h("dt", { text: bez }), inhalt ])); }
        if (inf.zeiten && inf.zeiten.length){
          zeile("Wann", h("dd", {}, [ h("ul", {}, inf.zeiten.map(function(z){ return h("li", { text: z }); })) ]));
        }
        if (inf.ort)     zeile("Wo", h("dd", { text: inf.ort }));
        if (inf.kontakt) zeile("Ansprechpartner", h("dd", { text: inf.kontakt }));
        if (dl.children.length) out.push(dl);
      } else {
        out.push(h("p", { "class": "lead", text: "Alle Informationen zu „" + grp.name + "“ findest du auf der Seite der Gruppe." }));
      }
      out.push(h("div", { "class": "btns" }, [
        ext("Alle Infos zu " + grp.name + " →", grp.pfad),
        knopf("← Zurück zu " + abt.name, ["abteilungen", slug(abt.name)], "btn rand")
      ]));
      return out;
    }

    // Ebene 2: Gruppen einer Abteilung
    var res = [
      krumen(wurzel.concat([{ text: abt.name }])),
      titel(abt.name),
      h("p", { "class": "lead", text: abt.kurz })
    ];
    abt.gruppen.forEach(function(k){
      if (k.titel) res.push(h("h3", { "class": "kat", text: k.titel }));
      var r = h("div", { "class": "karten" });
      k.eintraege.forEach(function(e){ r.appendChild(karte(e.name, "", ["abteilungen", slug(abt.name), slug(e.name)])); });
      res.push(r);
    });
    res.push(h("div", { "class": "btns" }, [ ext("Zur Abteilungsseite →", abt.pfad, "btn rand") ]));
    return res;
  }

  function ansichtAktuelles(){
    var liste = h("ul", { "class": "meldungen" });
    NEWS.forEach(function(n){
      liste.appendChild(h("li", {}, [
        h("a", { href: BASIS + n.pfad, target: "_top", rel: "noopener" }, [
          h("span", {}, [ n.datum ? h("small", { text: n.datum }) : null, n.titel ]),
          h("span", { "class": "pfeil", "aria-hidden": "true", text: "→" })
        ])
      ]));
    });
    return [
      titel("Aktuelles"),
      h("p", { "class": "lead", text: "Neuigkeiten aus dem Verein und den Abteilungen." }),
      liste,
      h("div", { "class": "btns" }, [ ext("Alle Meldungen aus den Abteilungen →", SEITEN.alleMeldungen, "btn rand") ])
    ];
  }

  function ansichtTermine(){
    var out = [ titel("Termine"), h("p", { "class": "lead", text: "Spiele, Kurse und Veranstaltungen aller Abteilungen." }) ];
    if (TERMINE_URL){
      out.push(h("iframe", { "class": "termine-frame", src: TERMINE_URL, title: "Terminkalender des TSV Simmozheim", loading: "lazy" }));
    }
    out.push(h("div", { "class": "btns" }, [ ext("Veranstaltungen & Hallenbelegung →", SEITEN.veranstaltungen, "btn rand") ]));
    return out;
  }

  function ansichtKontakt(){
    var boxen = h("div", { "class": "boxen" });
    boxen.appendChild(h("div", { "class": "box" }, [
      h("h3", { text: "Adresse" }),
      h("address", {}, [ KONTAKT.name, h("br"), KONTAKT.strasse, h("br"), KONTAKT.ort ])
    ]));
    if (KONTAKT.telefon || KONTAKT.email){
      var p = h("p");
      if (KONTAKT.telefon) p.appendChild(document.createTextNode("Telefon: " + KONTAKT.telefon));
      if (KONTAKT.telefon && KONTAKT.email) p.appendChild(h("br"));
      if (KONTAKT.email){
        p.appendChild(document.createTextNode("E-Mail: "));
        p.appendChild(h("a", { href: "mailto:" + KONTAKT.email, text: KONTAKT.email }));
      }
      boxen.appendChild(h("div", { "class": "box" }, [ h("h3", { text: "Telefon & E-Mail" }), p ]));
    }
    boxen.appendChild(h("div", { "class": "box" }, [
      h("h3", { text: "Ansprechpartner" }),
      h("p", { text: "Vorstand, Abteilungsleiter und Übungsleiter findest du übersichtlich auf einer Seite." }),
      h("p", { style: "margin-top:10px" }, [ ext("Zu den Ansprechpartnern →", SEITEN.ansprechpartner, "") ])
    ]));
    return [ titel("So erreichst du uns"), h("p", { "class": "lead", text: "Wir freuen uns über deine Nachricht." }), boxen ];
  }

  function ansichtMitglied(){
    return [
      titel("Mitglied werden"),
      h("p", { "class": "lead", text: "Probiere unsere Angebote unverbindlich aus – wir freuen uns auf dich." }),
      h("ul", { "class": "liste" }, [
        h("li", { text: "Für Kinder, Jugendliche und Erwachsene" }),
        h("li", { text: "Qualifizierte Übungsleiterinnen und Übungsleiter" }),
        h("li", { text: "Gemeinschaft im Verein vor Ort" })
      ]),
      h("div", { "class": "btns" }, [
        ext("Beitrittserklärung", SEITEN.beitritt),
        ext("Beiträge", SEITEN.beitraege, "btn rand"),
        knopf("Fragen? Kontakt", ["kontakt"], "btn rand")
      ])
    ];
  }

  var ANSICHTEN = {
    abteilungen: ansichtAbteilungen, aktuelles: ansichtAktuelles, termine: ansichtTermine,
    kontakt: ansichtKontakt, mitglied: ansichtMitglied
  };

  /* ---------- Kacheln aufbauen ---------- */
  TABS.forEach(function(t){
    kacheln.appendChild(h("button", { type: "button", "class": "tile", "data-tab": t.id, onclick: function(){ go([t.id]); } }, [
      svg(ICONS[t.id]), h("span", { text: t.label })
    ]));
  });

  /* ---------- Anzeige ---------- */
  function route(){
    var roh = location.hash.replace(/^#\/?/, "");
    var p = roh ? roh.split("/").map(function(s){ try { return decodeURIComponent(s); } catch (e) { return s; } }) : [];
    var tab = ANSICHTEN[p[0]] ? p[0] : "abteilungen";
    if (tab !== p[0]) p = [tab];

    Array.prototype.forEach.call(kacheln.children, function(b){
      if (b.getAttribute("data-tab") === tab) b.setAttribute("aria-current", "true");
      else b.removeAttribute("aria-current");
    });

    inhalt.innerHTML = "";
    ANSICHTEN[tab](p).forEach(function(n){ inhalt.appendChild(n); });

    if (fokusSetzen){
      var ue = inhalt.querySelector("h2");
      if (ue){ ue.setAttribute("tabindex", "-1"); ue.focus({ preventScroll: true }); }
      fokusSetzen = false;
    }
  }
  window.addEventListener("hashchange", route);
  route();
})();
</script>
</body>
</html>
