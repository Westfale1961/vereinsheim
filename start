      ]},
      { titel: "Erwachsene", eintraege: [
        g("Breitensport – Übersicht",  "/Turnen/Erwachsene/BreitensportUebersichtaufeinenBlick/"),
        g("Athletik-Core-Training",    "/Turnen/Erwachsene/AthletikCoreTraining/"),
        g("Bodyfit",                   "/Turnen/Erwachsene/Bodyfit/"),
        g("Fitness",                   "/Turnen/Erwachsene/Fitness/"),
        g("Frauengymnastik – Fit mit Musik", "/Turnen/Erwachsene/FrauengymnastikFitmitMusik/"),
        g("Jedermannsport",            "/Turnen/Erwachsene/Jedermannsport/"),
        g("Lauftreff",                 "/Turnen/Erwachsene/Lauftreff/"),
        g("Volleyball",                "/Turnen/Erwachsene/Volleyball/")
      ]},
      { titel: "Radsport", eintraege: [
        g("Mountainbike",              "/Radsport/MTB/AllgemeineInfos/"),
        g("Indoor Cycling",            "/Radsport/IndoorCycling/TeamIndoorCycling/")
      ]},
      { titel: "Allgemeines", eintraege: [
        g("Infos aus der Abteilung",   "/Turnen/AllgemeineInfos/InfosausderAbteilung/"),
        g("Vereinskleidung",           "/Turnen/AllgemeineInfos/Vereinskleidung/"),
