<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>TSV Simmozheim – Startseite</title>

<!--
  ============================================================
  ANLEITUNG (kann gelöscht werden)

  Diese Seite wird per iFrame in die Startseite der Vereinshomepage eingebunden.
  Oben stehen fünf Kacheln (Abteilungen, Aktuelles, Termine, Kontakt, Mitglied werden),
  darunter erscheint der Inhalt der gewählten Kachel.
  Bei "Abteilungen": Abteilung wählen -> Gruppe wählen -> Informationen zur Gruppe.

  Das Vereinslogo kommt aus dem Kopfbereich der Homepage (nicht aus dieser Seite).

  Alles, was ihr pflegt, steht im Skript ganz unten:
    1. EINSTELLUNGEN   Adresse der Homepage, Kalender-Adresse, Kontaktdaten
    2. NEWS            die Meldungen unter "Aktuelles"
    3. ABTEILUNGEN     Abteilungen, Gruppen und deren Infos
       Zu jeder Gruppe gehört der Link zur bestehenden Seite auf der Homepage.
       Zusätzlich kann eine Kurzinfo eingetragen werden, die dann direkt
       unter der Gruppe angezeigt wird (Beispiel im Skript).

  Farben: unten im :root-Block (--farbe-...).
  Die Seite braucht keine externen Dateien, Schriften oder Skripte (datenschutzfreundlich).
  ============================================================
-->

<style>
:root{
  --farbe-primaer:#4460af;        /* Hauptfarbe (Blau der Homepage) */
  --farbe-primaer-dunkel:#2a3b78;
  --farbe-primaer-hell:#e9edf8;
  --farbe-akzent:#d43888;         /* Akzent (Pink der Homepage) */
  --farbe-text:#1c2433;
  --farbe-text-hell:#566074;
  --farbe-flaeche:#f3f5fa;        /* Hintergrund (passt zur Homepage-Gestaltung) */
  --farbe-karte:#ffffff;
  --farbe-linie:#dde3ee;
  --radius:16px;
  --schatten:0 6px 24px rgba(42,59,120,.10);
}
*{box-sizing:border-box}
html{background:var(--farbe-flaeche)}
body{
  margin:0;padding:4px 2px 24px;background:var(--farbe-flaeche);color:var(--farbe-text);
  font-family:system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  font-size:17px;line-height:1.55;
}
a{color:var(--farbe-primaer)}
button{font:inherit;color:inherit}
a:focus-visible,button:focus-visible{outline:3px solid var(--farbe-akzent);outline-offset:3px;border-radius:8px}
.app{max-width:1100px;margin:0 auto}

/* ---------- Kacheln ---------- */
.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(9em,1fr));gap:12px;margin:0 0 20px}
.tile{
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;
  padding:16px 8px;min-height:6.2em;text-align:center;cursor:pointer;
  background:var(--farbe-karte);border:1px solid var(--farbe-linie);border-radius:var(--radius);
  font-weight:700;font-size:1rem;line-height:1.2;
  transition:transform .15s ease,box-shadow .15s ease,border-color .15s ease,background .15s ease,color .15s ease;
}
.tile svg{width:28px;height:28px;fill:none;stroke:var(--farbe-primaer);stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.tile:hover{transform:translateY(-3px);box-shadow:var(--schatten);border-color:var(--farbe-primaer)}
.tile[aria-current="true"]{background:var(--farbe-primaer);border-color:var(--farbe-primaer);color:#fff;box-shadow:var(--schatten)}
.tile[aria-current="true"] svg{stroke:#fff}

/* ---------- Inhaltsbereich ---------- */
.panel{
  background:var(--farbe-karte);border:1px solid var(--farbe-linie);border-radius:var(--radius);
  box-shadow:var(--schatten);padding:28px;min-height:320px;
}
.panel > *{animation:ein .18s ease}
@keyframes ein{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
.panel h2{margin:0 0 6px;font-size:clamp(1.4rem,3vw,1.9rem);line-height:1.2;letter-spacing:-.01em}
.panel h2:focus{outline:none}
.panel h3.kat{margin:26px 0 10px;font-size:.82rem;font-weight:700;color:var(--farbe-primaer);text-transform:uppercase;letter-spacing:.07em}
.lead{margin:0 0 20px;color:var(--farbe-text-hell);max-width:62ch}

/* Pfad (Brotkrumen) */
.krumen{display:flex;flex-wrap:wrap;align-items:center;gap:4px 8px;margin:0 0 14px;font-size:.92rem;color:var(--farbe-text-hell)}
.krumen button{background:none;border:0;padding:2px 4px;cursor:pointer;color:var(--farbe-primaer);font-weight:600;text-decoration:underline;text-underline-offset:3px}
.krumen button:hover{color:var(--farbe-akzent)}
.krumen .trenner{color:var(--farbe-linie)}
.krumen [aria-current]{font-weight:700;color:var(--farbe-text)}

/* Auswahlkarten */
.karten{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:14px}
.karte{
  display:flex;align-items:center;justify-content:space-between;gap:12px;text-align:left;cursor:pointer;
  padding:18px 20px;background:var(--farbe-karte);border:1px solid var(--farbe-linie);border-radius:14px;
  transition:transform .15s ease,box-shadow .15s ease,border-color .15s ease;
}
.karte:hover{transform:translateY(-3px);box-shadow:var(--schatten);border-color:var(--farbe-primaer)}
.karte strong{display:block;font-size:1.1rem;line-height:1.25}
.karte small{display:block;margin-top:4px;color:var(--farbe-text-hell);font-size:.9rem;line-height:1.4}
.karte .pfeil{flex:none;color:var(--farbe-primaer);font-weight:700;font-size:1.2rem}
.karten.gross .karte{padding:22px 22px;min-height:7em;align-items:flex-start}

/* Informationen zur Gruppe */
.info{margin:18px 0 0;display:grid;gap:12px}
.info div{background:var(--farbe-flaeche);border-radius:12px;padding:14px 18px}
.info dt{font-size:.78rem;font-weight:700;color:var(--farbe-primaer);text-transform:uppercase;letter-spacing:.07em;margin:0 0 4px}
.info dd{margin:0;white-space:pre-line}
.info ul{margin:0;padding-left:20px}

/* Buttons */
.btns{display:flex;flex-wrap:wrap;gap:12px;margin-top:22px}
.btn{
  display:inline-block;padding:12px 22px;border-radius:999px;font-weight:700;text-decoration:none;cursor:pointer;
  background:var(--farbe-primaer);color:#fff;border:2px solid var(--farbe-primaer);
}
.btn:hover{background:var(--farbe-primaer-dunkel);border-color:var(--farbe-primaer-dunkel)}
.btn.rand{background:transparent;color:var(--farbe-primaer)}
.btn.rand:hover{background:var(--farbe-primaer-hell);color:var(--farbe-primaer-dunkel)}

/* Aktuelles */
.meldungen{list-style:none;margin:0;padding:0;display:grid;gap:12px}
.meldungen a{
  display:flex;justify-content:space-between;align-items:center;gap:12px;text-decoration:none;color:var(--farbe-text);font-weight:700;
  padding:16px 20px;border:1px solid var(--farbe-linie);border-radius:14px;
  transition:transform .15s ease,box-shadow .15s ease,border-color .15s ease;
}
.meldungen a:hover{transform:translateY(-2px);box-shadow:var(--schatten);border-color:var(--farbe-primaer)}
.meldungen .pfeil{color:var(--farbe-primaer)}
.meldungen small{display:block;font-weight:500;color:var(--farbe-text-hell)}

/* Termine */
.termine-frame{display:block;width:100%;height:600px;border:1px solid var(--farbe-linie);border-radius:var(--radius);background:#fff}

/* Kontakt / Mitglied werden */
.boxen{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px}
.box{background:var(--farbe-flaeche);border-radius:14px;padding:18px 20px}
.box h3{margin:0 0 6px;font-size:1.02rem}
.box p,.box address{margin:0;font-style:normal}
.liste{margin:14px 0 0;padding-left:20px;color:var(--farbe-text-hell)}

@media (max-width:600px){
  .panel{padding:18px}
  .tiles{grid-template-columns:repeat(2,1fr)}
  .tile{min-height:5.4em}
  .termine-frame{height:520px}
}
@media (prefers-reduced-motion:reduce){
  .panel > *{animation:none}
  .tile,.karte,.meldungen a{transition:none}
  .tile:hover,.karte:hover,.meldungen a:hover{transform:none}
}
</style>
</head>
<body>

<div class="app">
  <nav class="tiles" id="kacheln" aria-label="Bereiche der Vereinsseite"></nav>
  <main class="panel" id="inhalt"></main>
  <noscript>
