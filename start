        g("Jugendleichtathletik",      "/Turnen/KinderundJugendliche/Leichtathletik/"),
        g("Eltern-Kind-Turnen",        "/Turnen/KinderundJugendliche/ElternKindGruppen/"),
        g("Vorschulturnen",            "/Turnen/KinderundJugendliche/Vorschulturnen/"),
        g("Buben- und Jugendturnen",   "/Turnen/KinderundJugendliche/BubenundJugendturnen/"),
        g("HipHop – Magic’s",          "/Turnen/KinderundJugendliche/HipHopMagics/"),
